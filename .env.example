# Offentlig AdSense publisher-ID, for eksempel ca-pub-1234567890123456
VITE_GOOGLE_ADS_CLIENT=ca-pub-0000000000000000

# Numerisk ID for en responsiv displayannonse opprettet i AdSense
VITE_GOOGLE_ADS_SLOT_HOME=0000000000

# Serverhemmelighet for valgfrie AI-funksjoner. Ikke bruk VITE_-prefiks.
OPENAI_API_KEY=

# Modell med støtte for Responses API og strict Structured Outputs.
OPENAI_MODEL=gpt-5.4-mini
